# ==============================================================================
# Autonomous AI SRE Incident Commander - Environment Configuration Template
# ==============================================================================
# Duplicate this file to '.env' and populate your secrets before running:
# docker compose up -d --build
# ==============================================================================

# --- n8n Security & Orchestration Engine ---
# Must be at least 24 characters (cryptographic key used by n8n to encrypt credentials in Postgres)
N8N_ENCRYPTION_KEY=sre_autonomous_commander_key_secure_2026_xyz

# n8n Port & Base Editor URL for human SRE console access
N8N_PORT=5678
N8N_EDITOR_BASE_URL=http://localhost:5678

# --- PostgreSQL State Database Configuration ---
DB_POSTGRESDB_USER=sre_admin
DB_POSTGRESDB_PASSWORD=sre_high_entropy_password_98234
DB_POSTGRESDB_DATABASE=n8n_state_db
DB_POSTGRESDB_PORT=5432

# --- GitHub Integration (Forensics & Autonomous Hotfix PR) ---
# Fine-grained PAT with 'Contents: Read & Write' and 'Pull Requests: Read & Write'
GITHUB_ACCESS_TOKEN=ghp_examplePersonalAccessTokenWithRepoScopeRequired

# Target repository details housing microservice source
GITHUB_REPO_OWNER=your-github-username-or-org
GITHUB_REPO_NAME=self-healing-sre-agent

# --- AI Cognitive Engine (Root-Cause Analysis & Code Synthesis) ---
# OpenAI API key (requires access to gpt-4o or gpt-4-turbo)
OPENAI_API_KEY=sk-proj-exampleOpenAiKeyForIncidentCommanderAutonomousReasoning

# --- Human-In-The-Loop (HITL) Alerting & Post-Mortem Destination ---
# Incoming Webhook URL from Slack App or Discord/Mock incoming webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX

# --- Telemetry & Microservice Networking ---
# URL where the telemetry simulator dispatches alerting webhooks
N8N_WEBHOOK_URL=http://n8n:5678/webhook/sre-incident-alert

# Internal container DNS address of the mock target microservice
MOCK_SERVICE_URL=http://mock-microservice:8000

# Telemetry monitoring thresholds
ERROR_THRESHOLD_PERCENT=5.0
POLL_INTERVAL_SECONDS=5.0
ALERT_COOLDOWN_SECONDS=60.0
AUTO_GENERATE_TRAFFIC=true
DEFAULT_FAILURE_PROBABILITY=0.20
